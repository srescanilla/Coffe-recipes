// ---- picker de MOLTA (ronda 5): dues columnes fixes (Espresso / V60) amb
// capcalera sempre visible, en lloc d'una llista unica amb dues seccions
// que et calia baixar per veure. Navegacio: AMUNT/AVALL mouen el focus
// dins la columna activa, MENU canvia de columna, OK aplica.
#define MOLTA_ESP_MIN 10
#define MOLTA_ESP_MAX 25
#define MOLTA_V60_MIN 55
#define MOLTA_V60_MAX 80
#define MOLTA_ESP_N   (MOLTA_ESP_MAX - MOLTA_ESP_MIN + 1)
#define MOLTA_V60_N   (MOLTA_V60_MAX - MOLTA_V60_MIN + 1)
int moltaColActiva = 0;      // 0 = Espresso, 1 = V60
int moltaSelEsp = 0;         // index dins el rang Espresso (0..15)
int moltaSelV60 = 0;         // index dins el rang V60 (0..15)
int moltaScrollEsp = 0;
int moltaScrollV60 = 0;

// ---- picker de GRAMS (ronda 6): mateix patro de dues columnes que MOLTA —
// "Dosis simple" (17-18gr) i "Dosis doble" (19-22gr), valors demanats
// directament per l'usuari (no son una divisio automatica del rang antic
// 15-38gr, que ja no es fa servir enlloc).
#define GRAMS_SIMPLE_MIN 17
#define GRAMS_SIMPLE_MAX 18
#define GRAMS_DOBLE_MIN  19
#define GRAMS_DOBLE_MAX  22
#define GRAMS_SIMPLE_N   (GRAMS_SIMPLE_MAX - GRAMS_SIMPLE_MIN + 1)
#define GRAMS_DOBLE_N    (GRAMS_DOBLE_MAX - GRAMS_DOBLE_MIN + 1)
int gramsColActiva = 0;      // 0 = Dosis simple, 1 = Dosis doble
int gramsSelSimple = 0;
int gramsSelDoble = 0;
int gramsScrollSimple = 0;
int gramsScrollDoble = 0;

bool calRedibuixar = true;

// ---- pantalla "carregat" (ronda 11): apareix quan el mobil selecciona
// explicitament un perfil via BLE (comanda SEL, vegeu processaComandaBLE) —
// no quan navegues localment amb AMUNT/AVALL, nomes quan el canvi ve del
// mobil. Es tanca sola al cap de SPLASH_DURADA_MS o amb qualsevol tecla
// (vegeu loop()).
#define SPLASH_DURADA_MS 3000
bool splashActiva = false;
unsigned long splashInici = 0;
char splashNom[LEN_NOM] = "";

// Notes de tast habituals — llista curada perque no calgui escriure-les.
// Escrites en ASCII pla per simplicitat pròpia (no calen accents en cap
// d'aquests mots) — el font i el decodificador BLE ja admeten accents des
// de la ronda 5 (vegeu aFolreASCII mes avall) si algun dia en cal algun.
const char *NOTES_CURADES[] = {
  "Xocolata", "Caramel", "Nous", "Ametlla", "Mel", "Sucre moreno",
  "Citrics", "Llimona", "Taronja", "Poma", "Maduixa", "Nabius",
  "Fruita tropical", "Raim", "Gessami", "Rosa", "Herbaci",
  "Especiat", "Terros", "Vainilla"
};
const int N_NOTES_CURADES = sizeof(NOTES_CURADES) / sizeof(NOTES_CURADES[0]);

