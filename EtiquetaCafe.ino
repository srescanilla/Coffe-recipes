// ================================================================== setup
void setup() {
  Serial.begin(115200);
  epd.begin();
  carregaPresets();
  configuraBLE();
  calRedibuixar = true;
}

// =================================================================== loop
void loop() {
  bool up    = epd.premut(CP_UP);
  bool down  = epd.premut(CP_DOWN);
  bool ok    = epd.premut(CP_OK);
  bool menu  = epd.premut(CP_MENU);
  bool exit_ = epd.premut(CP_EXIT);

  if (bleLiniaPendent) {
    processaComandaBLE(bleLiniaProcessar);
    bleLiniaPendent = false;
    calRedibuixar = true;
  }

  if (splashActiva) {
    // Ronda 11: qualsevol tecla la tanca abans d'hora; si no, es tanca sola
    // al cap de SPLASH_DURADA_MS. Mentre es mostra, no es processa cap altra
    // navegacio (picker o pantalla principal) — nomes dismissar.
    bool qualsevolTecla = up || down || ok || menu || exit_;
    if (qualsevolTecla || (millis() - splashInici >= SPLASH_DURADA_MS)) {
      splashActiva = false;
      mostraFocus = true;
      calRedibuixar = true;
    }
  } else if (pickerObert) {
    gestionaPicker(up, down, ok, menu, exit_);
  } else {
    gestionaPantallaPrincipal(up, down, ok, menu, exit_);
  }

  if (calRedibuixar) {
    dibuixa();
    epd.show();
    calRedibuixar = false;
  }
  epd.tasca();
}

// ============================================================ navegacio UI
void gestionaPantallaPrincipal(bool up, bool down, bool ok, bool menu, bool exit_) {
  if (ok) {
    // OK es un interruptor: entra a "modificar" la casella marcada i, si ja
    // hi eres, en surt confirmant (desant qualsevol canvi pendent).
    editant = !editant;
    if (!editant && brut) desaNVS();
    mostraFocus = true;
    calRedibuixar = true;
  }
  if (exit_) {
    if (brut) desaNVS();
    editant = false;
    // Ronda 6: EXIT deixa la pantalla neta, sense cap requadre de seleccio
    // fins que l'usuari torni a interactuar (vegeu mostraFocus).
    mostraFocus = false;
    calRedibuixar = true;
  }
  if (menu && numPresets > 0) {
    editant = false;   // el picker ja aplica el valor triat; tornem a "navegar"
    mostraFocus = true;
    obrePicker();
    // MOLTA (ronda 5) i GRAMS (ronda 6) ja no fan servir pickerN — cadascun
    // te el seu propi estat de dues columnes — per aixo cal deixar-los obrir
    // encara que pickerN es quedi a 0; sense aquest cas especial els seus
    // submenus no s'obrien mai (el mateix bug de MOLTA es va repetir amb
    // GRAMS perque vaig oblidar actualitzar aquesta condicio quan li vaig
    // donar el mateix tractament).
    if (pickerN > 0 || campActiu == CAMP_MOLTA || campActiu == CAMP_GRAMS) pickerObert = true;
    calRedibuixar = true;
  }
  if ((up || down) && numPresets > 0) {
    // Ronda 8: la direccio estava invertida respecte a la pantalla, i era un
    // bug de logica independent del pin fisic (per aixo el canvi de pins de
    // la ronda 7 va arreglar els submenus pero no la pantalla principal — no
    // podia, son bugs diferents). VARIETAT es la casella de dalt de tot i
    // GRAMS/MOLTA/NOTES son la fila de sota; per tant AVALL ha d'avancar
    // (VARIETAT->GRAMS->...) i AMUNT ha de retrocedir — abans era al reves
    // (`up ? 1 : -1`), fent que AMUNT avances "cap avall" per la llista.
    // Aquest mateix `dir` tambe governa VARIETAT (cafe seguent/anterior) i
    // GRAMS/MOLTA (sumar/restar 0.5) en mode "modificar", que ara queden
    // amb el mateix criteri que el picker (AMUNT=enrere, AVALL=endavant).
    int dir = up ? -1 : 1;
    mostraFocus = true;
    if (!editant) {
      // Mode navegar: AMUNT/AVALL nomes mouen el focus entre caselles.
      campActiu = (campActiu + dir + N_CAMPS) % N_CAMPS;
      calRedibuixar = true;
    } else {
      // Mode modificar: AMUNT/AVALL canvien el valor de la casella marcada.
      switch (campActiu) {
        case CAMP_NOM:
          canviaSeleccio(dir);
          calRedibuixar = true;
          break;
        case CAMP_GRAMS:
          presets[selIndex].grams += dir * 0.5f;
          if (presets[selIndex].grams < 0)  presets[selIndex].grams = 0;
          if (presets[selIndex].grams > 60) presets[selIndex].grams = 60;
          brut = true;
          calRedibuixar = true;
          break;
        case CAMP_MOLTA:
          presets[selIndex].molta += dir * 0.5f;
          if (presets[selIndex].molta < 0)   presets[selIndex].molta = 0;
          if (presets[selIndex].molta > 100) presets[selIndex].molta = 100;
          brut = true;
          calRedibuixar = true;
          break;
        case CAMP_NOTES:
          // Les notes nomes es canvien des del submenu (MENU); AMUNT/AVALL
          // no fan res aqui — evita poder-les "escriure" sense voler.
          break;
      }
    }
  }
}

// Dins la llista: NOM/NOTES es la llista generica de sempre (NOTES amb
// seleccio multiple). MOLTA (ronda 5) i GRAMS (ronda 6) tenen cadascuna la
// seva propia navegacio de dues columnes, gestionada a part perque MENU hi
// fa una altra cosa (canviar de columna) i cap de les dues fa servir ja
// pickerN/pickerEtiquetes.
void gestionaPicker(bool up, bool down, bool ok, bool menu, bool exit_) {
  if (campActiu == CAMP_MOLTA) { gestionaPickerMolta(up, down, ok, menu, exit_); return; }
  if (campActiu == CAMP_GRAMS) { gestionaPickerGrams(up, down, ok, menu, exit_); return; }

  if (pickerN == 0) { pickerObert = false; calRedibuixar = true; return; }

  if (up)   { mouSeleccioPicker(-1); calRedibuixar = true; }
  if (down) { mouSeleccioPicker(1);  calRedibuixar = true; }

  if (campActiu == CAMP_NOTES) {
    if (ok) {
      int marcades = 0;
      for (int i = 0; i < pickerN; i++) if (pickerMarcat[i]) marcades++;
      if (pickerMarcat[pickerSel]) pickerMarcat[pickerSel] = false;
      else if (marcades < 3) pickerMarcat[pickerSel] = true;
      calRedibuixar = true;
    }
    if (menu) { aplicaPicker(); pickerObert = false; calRedibuixar = true; }
  } else {
    if (ok) { aplicaPicker(); pickerObert = false; calRedibuixar = true; }
  }
  if (exit_) { pickerObert = false; calRedibuixar = true; }
}

// AMUNT/AVALL mouen el seleccionat dins la columna activa (Espresso o V60),
// MENU canvia quina columna es l'activa, OK aplica el valor seleccionat de
// la columna activa i tanca, EXIT cancela sense aplicar.
void gestionaPickerMolta(bool up, bool down, bool ok, bool menu, bool exit_) {
  int *sel = (moltaColActiva == 0) ? &moltaSelEsp : &moltaSelV60;
  int n    = (moltaColActiva == 0) ? MOLTA_ESP_N  : MOLTA_V60_N;
  if (up)   { *sel = (*sel - 1 + n) % n; calRedibuixar = true; }
  if (down) { *sel = (*sel + 1) % n;     calRedibuixar = true; }
  if (menu) { moltaColActiva = 1 - moltaColActiva; calRedibuixar = true; }
  if (ok) {
    int valor = (moltaColActiva == 0) ? (MOLTA_ESP_MIN + moltaSelEsp) : (MOLTA_V60_MIN + moltaSelV60);
    presets[selIndex].molta = (float)valor;
    brut = true;
    pickerObert = false;
    calRedibuixar = true;
  }
  if (exit_) { pickerObert = false; calRedibuixar = true; }
}

// Mateixa logica que gestionaPickerMolta() pero per GRAMS (ronda 6): AMUNT/
// AVALL mouen el seleccionat dins la columna activa (Dosis simple o Dosis
// doble), MENU canvia de columna, OK aplica i EXIT cancela.
void gestionaPickerGrams(bool up, bool down, bool ok, bool menu, bool exit_) {
  int *sel = (gramsColActiva == 0) ? &gramsSelSimple : &gramsSelDoble;
  int n    = (gramsColActiva == 0) ? GRAMS_SIMPLE_N  : GRAMS_DOBLE_N;
  if (up)   { *sel = (*sel - 1 + n) % n; calRedibuixar = true; }
  if (down) { *sel = (*sel + 1) % n;     calRedibuixar = true; }
  if (menu) { gramsColActiva = 1 - gramsColActiva; calRedibuixar = true; }
  if (ok) {
    int valor = (gramsColActiva == 0) ? (GRAMS_SIMPLE_MIN + gramsSelSimple) : (GRAMS_DOBLE_MIN + gramsSelDoble);
    presets[selIndex].grams = (float)valor;
    brut = true;
    pickerObert = false;
    calRedibuixar = true;
  }
  if (exit_) { pickerObert = false; calRedibuixar = true; }
}

void mouSeleccioPicker(int dir) {
  if (pickerN == 0) return;
  int intents = 0;
  do {
    pickerSel = (pickerSel + dir + pickerN) % pickerN;
    intents++;
  } while (pickerEsCapcalera[pickerSel] && intents <= pickerN);
}

void canviaSeleccio(int dir) {
  if (numPresets == 0) return;
  if (brut) desaNVS();
  selIndex = (selIndex + dir + numPresets) % numPresets;
  prefs.putString("sel", presets[selIndex].nom);
}

// Ronda 11e: marca `idx` com el perfil actiu i dispara la pantalla "Carregat
// satisfactoriament" — extret de la comanda SEL (vegeu processaComandaBLE)
// perque ara tambe el fa servir ADD ("Save to label" al mobil), a peticio
// teva: volies que la confirmacio sortis quan deses/actualitzes un cafe des
// del formulari, no nomes quan prems el boto "Load" separat.
void activaPerfilISplash(int idx) {
  selIndex = idx;
  prefs.putString("sel", presets[idx].nom);
  strncpy(splashNom, presets[idx].nom, LEN_NOM - 1);
  splashNom[LEN_NOM - 1] = '\0';
  splashActiva = true;
  splashInici = millis();
  pickerObert = false;
  editant = false;
}

// ---------------------------------------------------------------- picker
void afegeixFila(const char *text, bool capcalera) {
  if (pickerN >= MAX_PICKER) return;
  strncpy(pickerEtiquetes[pickerN], text, LEN_NOTES - 1);
  pickerEtiquetes[pickerN][LEN_NOTES - 1] = '\0';
  pickerEsCapcalera[pickerN] = capcalera;
  pickerMarcat[pickerN] = false;
  pickerN++;
}

// Pre-marca a la llista curada de NOTES les entrades que ja formen part de
// la nota actual del cafe seleccionat (si en torna a obrir el submenu, veu
// el que ja tenia triat).
void marcaPreseleccio() {
  char copia[LEN_NOTES];
  strncpy(copia, presets[selIndex].notes, LEN_NOTES - 1);
  copia[LEN_NOTES - 1] = '\0';
  char *tros = strtok(copia, ",");
  while (tros) {
    while (*tros == ' ') tros++;
    for (int i = 0; i < pickerN; i++) {
      if (strcasecmp(pickerEtiquetes[i], tros) == 0) { pickerMarcat[i] = true; break; }
    }
    tros = strtok(NULL, ",");
  }
}

void obrePicker() {
  pickerN = 0;
  pickerScroll = 0;

  if (campActiu == CAMP_NOM) {
    for (int i = 0; i < numPresets; i++) afegeixFila(presets[i].nom, false);
    pickerSel = (selIndex >= 0) ? selIndex : 0;

  } else if (campActiu == CAMP_GRAMS) {
    // Picker de dues columnes (ronda 6, vegeu dibuixaPickerGrams): mateix
    // patro que MOLTA — decidim amb quina s'obre segons el valor actual.
    int actual = (int)roundf(presets[selIndex].grams);
    bool dinsSimple = actual >= GRAMS_SIMPLE_MIN && actual <= GRAMS_SIMPLE_MAX;
    bool dinsDoble  = actual >= GRAMS_DOBLE_MIN  && actual <= GRAMS_DOBLE_MAX;
    if (dinsSimple) {
      gramsColActiva = 0;
    } else if (dinsDoble) {
      gramsColActiva = 1;
    } else {
      int dSimple = min(abs(actual - GRAMS_SIMPLE_MIN), abs(actual - GRAMS_SIMPLE_MAX));
      int dDoble  = min(abs(actual - GRAMS_DOBLE_MIN),  abs(actual - GRAMS_DOBLE_MAX));
      gramsColActiva = (dDoble < dSimple) ? 1 : 0;
    }
    gramsSelSimple = constrain(actual - GRAMS_SIMPLE_MIN, 0, GRAMS_SIMPLE_N - 1);
    gramsSelDoble  = constrain(actual - GRAMS_DOBLE_MIN,  0, GRAMS_DOBLE_N - 1);
    gramsScrollSimple = 0;
    gramsScrollDoble = 0;

  } else if (campActiu == CAMP_MOLTA) {
    // Picker de dues columnes (vegeu dibuixaPickerMolta): decidim amb quina
    // s'obre segons a quin rang cau el valor actual del cafe.
    int actual = (int)roundf(presets[selIndex].molta);
    bool dinsEsp = actual >= MOLTA_ESP_MIN && actual <= MOLTA_ESP_MAX;
    bool dinsV60 = actual >= MOLTA_V60_MIN && actual <= MOLTA_V60_MAX;
    if (dinsEsp) {
      moltaColActiva = 0;
    } else if (dinsV60) {
      moltaColActiva = 1;
    } else {
      int dEsp = min(abs(actual - MOLTA_ESP_MIN), abs(actual - MOLTA_ESP_MAX));
      int dV60 = min(abs(actual - MOLTA_V60_MIN), abs(actual - MOLTA_V60_MAX));
      moltaColActiva = (dV60 < dEsp) ? 1 : 0;
    }
    moltaSelEsp = constrain(actual - MOLTA_ESP_MIN, 0, MOLTA_ESP_N - 1);
    moltaSelV60 = constrain(actual - MOLTA_V60_MIN, 0, MOLTA_V60_N - 1);
    moltaScrollEsp = 0;
    moltaScrollV60 = 0;

  } else if (campActiu == CAMP_NOTES) {
    for (int i = 0; i < N_NOTES_CURADES; i++) afegeixFila(NOTES_CURADES[i], false);
    marcaPreseleccio();
    pickerSel = 0;
  }
}

const char *titolPicker() {
  switch (campActiu) {
    case CAMP_NOM:   return "VARIETAT";
    case CAMP_GRAMS: return "GRAMS";
    case CAMP_MOLTA: return "N\xFAmero de molta";
    default:         return "NOTES (tria fins a 3)";
  }
}

void aplicaPicker() {
  // CAMP_GRAMS (ronda 6) i CAMP_MOLTA: gestionats del tot per
  // gestionaPickerGrams()/gestionaPickerMolta() (apliquen el valor
  // directament, no passen per aqui — pickers de dues columnes). Nomes
  // NOM i NOTES fan servir encara aquesta funcio.
  if (campActiu == CAMP_NOM) {
    if (brut) desaNVS();
    selIndex = pickerSel;
    prefs.putString("sel", presets[selIndex].nom);

  } else if (campActiu == CAMP_NOTES) {
    char resultat[LEN_NOTES] = "";
    for (int i = 0; i < pickerN; i++) {
      if (!pickerMarcat[i]) continue;
      size_t len = strlen(resultat);
      size_t afegit = strlen(pickerEtiquetes[i]) + (len > 0 ? 2 : 0);
      if (len + afegit >= LEN_NOTES) break;   // no hi cap mes, ho deixem estar
      if (len > 0) strcat(resultat, ", ");
      strcat(resultat, pickerEtiquetes[i]);
    }
    strncpy(presets[selIndex].notes, resultat, LEN_NOTES - 1);
    presets[selIndex].notes[LEN_NOTES - 1] = '\0';
    brut = true;
  }
}

// ---------------------------------------------------------------- desat NVS
// Valors com a text (nom del cafe), no posicions dins la llista — si la
// llista canvia (una addicio o un esborrat des del mobil), el que es mostra
// no salta a un altre cafe sense voler-ho. (NOTES-CrowPanel42.md #9)
void carregaPresets() {
  prefs.begin("cafe", false);
  numPresets = prefs.getInt("n", 0);
  if (numPresets > MAX_PRESETS) numPresets = MAX_PRESETS;
  size_t llegit = prefs.getBytes("ps", presets, sizeof(Preset) * MAX_PRESETS);
  if (llegit != sizeof(Preset) * MAX_PRESETS) numPresets = 0;   // primer arrencada

  selIndex = -1;
  if (numPresets > 0) {
    String selDesat = prefs.getString("sel", "");
    selIndex = 0;
    for (int i = 0; i < numPresets; i++) {
      if (selDesat.equals(presets[i].nom)) { selIndex = i; break; }
    }
  }
}

void desaNVS() {
  prefs.putBytes("ps", presets, sizeof(Preset) * MAX_PRESETS);
  prefs.putInt("n", numPresets);
  if (selIndex >= 0) prefs.putString("sel", presets[selIndex].nom);
  brut = false;
}

int trobaPerNom(const char *nom) {
  for (int i = 0; i < numPresets; i++) if (strcmp(presets[i].nom, nom) == 0) return i;
  return -1;
}

int insereixOrdenat(const char *nom) {
  int pos = numPresets;
  for (int i = 0; i < numPresets; i++) if (strcasecmp(nom, presets[i].nom) < 0) { pos = i; break; }
  for (int i = numPresets; i > pos; i--) presets[i] = presets[i - 1];
  strncpy(presets[pos].nom, nom, LEN_NOM - 1);
  presets[pos].nom[LEN_NOM - 1] = '\0';
  numPresets++;
  if (selIndex >= pos) selIndex++;
  return pos;
}

void reordenaPerNom() {
  char nomSel[LEN_NOM] = "";
  if (selIndex >= 0) { strncpy(nomSel, presets[selIndex].nom, LEN_NOM - 1); nomSel[LEN_NOM - 1] = '\0'; }
  for (int i = 1; i < numPresets; i++) {
    Preset tmp = presets[i];
    int j = i - 1;
    while (j >= 0 && strcasecmp(presets[j].nom, tmp.nom) > 0) { presets[j + 1] = presets[j]; j--; }
    presets[j + 1] = tmp;
  }
  selIndex = trobaPerNom(nomSel);
}

// -------------------------------------------------------- text ASCII segur
// Ronda 5: ABANS aquesta funcio aplanava tot accent a la lletra plana (à->a)
// perque el font namesos cobria ASCII 32-126. Ara CoffeeFreeFonts.h inclou
// tambe à,á,è,é,í,ò,ó,ú,ï,ü,ç,ñ (majuscules incloses) i el punt volat de
// "l·l" (vegeu gen_coffeefree_font.py, EXTRA_OK) — aixi que aqui nomes cal
// decodificar l'UTF-8 de 2 bytes que arriba per BLE i deixar passar el
// caracter real quan el tenim, i nomes caure a '?' pels accents que de
// veritat no tenim (p.ex. â,ê,ô amb circumflex, alemanys ä/ö, etc.).
void aFolreASCII(char *dst, const char *src, size_t cap) {
  size_t j = 0;
  for (size_t i = 0; src[i] != '\0' && j < cap - 1; ) {
    unsigned char c = (unsigned char)src[i];
    if (c < 0x80) {
      dst[j++] = (char)c; i++;
    } else if ((c & 0xE0) == 0xC0 && src[i + 1] != '\0') {
      unsigned char c2 = (unsigned char)src[i + 1];
      unsigned int cp = ((c & 0x1F) << 6) | (c2 & 0x3F);
      dst[j++] = mapejaAccent(cp);
      i += 2;
    } else {
      i++;   // seqüencia multibyte no esperada: la saltem
    }
  }
  dst[j] = '\0';
}

// Deixa passar el codepoint real (cap en un sol byte, Latin-1) quan el
// CoffeeFreeFonts.h el te dibuixat (mateix conjunt EXTRA_OK que el
// conversor de font); la resta cauen a '?' com abans.
char mapejaAccent(unsigned int cp) {
  switch (cp) {
    case 0xE0: case 0xE1: case 0xE8: case 0xE9: case 0xED:            // à á è é í
    case 0xF2: case 0xF3: case 0xFA: case 0xEF: case 0xFC: case 0xE7: // ò ó ú ï ü ç
    case 0xF1:                                                        // ñ
    case 0xC0: case 0xC1: case 0xC8: case 0xC9: case 0xCD:            // À Á È É Í
    case 0xD2: case 0xD3: case 0xDA: case 0xCF: case 0xDC: case 0xC7: // Ò Ó Ú Ï Ü Ç
    case 0xD1:                                                        // Ñ
    case 0xB7:                                                        // · (l·l)
      return (char)cp;
    default: return '?';
  }
}

const char *formataNum(float v, const char *unitat) {
  static char buf[16];
  snprintf(buf, sizeof(buf), "%.1f%s", v, unitat);
  return buf;
}

// =================================================================== BLE
// Protocol de text, una linia per comanda/resposta acabada en '\n'.
// Cada linia s'envia partida en trossos petits (~18 bytes) perque cap sempre
// dins l'MTU minim que qualsevol telefon garanteix, sense dependre que
// s'hagi negociat un MTU mes gran (NOTES-CrowPanel42.md #9).
//
//   Mobil -> placa (escriptura a CARACT_RX_UUID):
//     ADD|nom|grams|molta|notes   -> crea el cafe si no existeix, o
//                                     actualitza grams/molta/notes si ja hi era
//     DEL|nom                     -> esborra un cafe
//     REN|nomVell|nomNou          -> el reanomena
//     SYNC                        -> demana la llista sencera actual
//     PING                        -> comprovacio de connexio
//
//   Placa -> mobil (notificacions a CARACT_TX_UUID):
//     OK|ADD|nom  / ERR|ADD|motiu   (motiu: FORMAT, NOM_BUIT, PLE)
//     OK|DEL|nom  / ERR|DEL|NOTFOUND
//     OK|REN|nom  / ERR|REN|NOTFOUND|DUP
//     CNT|n, despres n linies ITEM|nom|grams|molta|notes, despres DONE|SYNC
//     PONG|1.0
void configuraBLE() {
  BLEDevice::init("EtiquetaCafe");
  BLEServer *servidor = BLEDevice::createServer();
  servidor->setCallbacks(new ElMeuServidor());
  BLEService *servei = servidor->createService(SERVEI_UUID);

  BLECharacteristic *rxChar = servei->createCharacteristic(
      CARACT_RX_UUID, BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  rxChar->setCallbacks(new RxCallback());

  txChar = servei->createCharacteristic(CARACT_TX_UUID, BLECharacteristic::PROPERTY_NOTIFY);
  txChar->addDescriptor(new BLE2902());

  servei->start();

  // El paquet d'anunci principal nomes te 31 bytes. Un UUID de servei de 128
  // bits (18 bytes) mes el nom "EtiquetaCafe" no hi caben junts: si els
  // poses tots dos al mateix paquet, la pila en descarta un en silenci -
  // normalment el nom, i aleshores el mobil no el troba mai pel filtre
  // namePrefix encara que la placa s'estigui anunciant perfectament. El nom
  // va al paquet principal (imprescindible per trobar-lo); el UUID del
  // servei, al scan response, que te el seu propi marge de 31 bytes.
  BLEAdvertisementData advData;
  advData.setFlags(0x06);   // LE General Discoverable, sense BR/EDR
  advData.setName("EtiquetaCafe");

  BLEAdvertisementData scanData;
  scanData.setCompleteServices(BLEUUID(SERVEI_UUID));

  BLEAdvertising *adv = BLEDevice::getAdvertising();
  adv->setAdvertisementData(advData);
  adv->setScanResponseData(scanData);
  adv->setScanResponse(true);
  BLEDevice::startAdvertising();
  Serial.println(F("[BLE] anunciant-se com a EtiquetaCafe"));
}

void enviaBLE(const char *linia) {
  if (!bleConnectat || !txChar) return;
  char buf[240];
  size_t total = snprintf(buf, sizeof(buf), "%s\n", linia);
  const size_t MIDA_TROS = 18;
  size_t pos = 0;
  while (pos < total) {
    size_t n = min(MIDA_TROS, total - pos);
    txChar->setValue((uint8_t *)(buf + pos), n);
    txChar->notify();
    pos += n;
    delay(8);
  }
}

void processaComandaBLE(char *linia) {
  char *guarda;
  char *cmd = strtok_r(linia, "|", &guarda);
  if (!cmd) return;

  if (strcmp(cmd, "PING") == 0) {
    enviaBLE("PONG|1.0");

  } else if (strcmp(cmd, "SYNC") == 0) {
    char capcalera[16];
    snprintf(capcalera, sizeof(capcalera), "CNT|%d", numPresets);
    enviaBLE(capcalera);
    for (int i = 0; i < numPresets; i++) {
      char buf[128], g[12], m[12];
      dtostrf(presets[i].grams, 0, 1, g);
      dtostrf(presets[i].molta, 0, 1, m);
      snprintf(buf, sizeof(buf), "ITEM|%s|%s|%s|%s", presets[i].nom, g, m, presets[i].notes);
      enviaBLE(buf);
    }
    enviaBLE("DONE|SYNC");

  } else if (strcmp(cmd, "ADD") == 0) {
    char *nomRaw   = strtok_r(NULL, "|", &guarda);
    char *gramsS   = strtok_r(NULL, "|", &guarda);
    char *moltaS   = strtok_r(NULL, "|", &guarda);
    char *notesRaw = strtok_r(NULL, "|", &guarda);
    if (!nomRaw || !gramsS || !moltaS) { enviaBLE("ERR|ADD|FORMAT"); return; }

    char nom[LEN_NOM], notes[LEN_NOTES];
    aFolreASCII(nom, nomRaw, sizeof(nom));
    aFolreASCII(notes, notesRaw ? notesRaw : "", sizeof(notes));
    if (strlen(nom) == 0) { enviaBLE("ERR|ADD|NOM_BUIT"); return; }

    int idx = trobaPerNom(nom);
    if (idx < 0) {
      if (numPresets >= MAX_PRESETS) { enviaBLE("ERR|ADD|PLE"); return; }
      idx = insereixOrdenat(nom);
    }
    presets[idx].grams = atof(gramsS);
    presets[idx].molta = atof(moltaS);
    strncpy(presets[idx].notes, notes, LEN_NOTES - 1);
    presets[idx].notes[LEN_NOTES - 1] = '\0';
    desaNVS();
    // Ronda 11e: "Save to label" ara tambe activa el perfil i dispara
    // l'splash (abans nomes ho feia si encara no hi havia cap cafe
    // seleccionat) — es el moment real en que el dispositiu s'actualitza,
    // segons vas indicar, aixi que es quan vols la confirmacio visual.
    activaPerfilISplash(idx);
    char resp[64]; snprintf(resp, sizeof(resp), "OK|ADD|%s", nom);
    enviaBLE(resp);

  } else if (strcmp(cmd, "DEL") == 0) {
    char *nomRaw = strtok_r(NULL, "|", &guarda);
    if (!nomRaw) { enviaBLE("ERR|DEL|FORMAT"); return; }
    char nom[LEN_NOM]; aFolreASCII(nom, nomRaw, sizeof(nom));
    int idx = trobaPerNom(nom);
    if (idx < 0) { enviaBLE("ERR|DEL|NOTFOUND"); return; }
    for (int i = idx; i < numPresets - 1; i++) presets[i] = presets[i + 1];
    numPresets--;
    if (selIndex == idx) selIndex = (numPresets > 0) ? 0 : -1;
    else if (selIndex > idx) selIndex--;
    desaNVS();
    char resp[64]; snprintf(resp, sizeof(resp), "OK|DEL|%s", nom);
    enviaBLE(resp);

  } else if (strcmp(cmd, "REN") == 0) {
    char *vellRaw = strtok_r(NULL, "|", &guarda);
    char *nouRaw  = strtok_r(NULL, "|", &guarda);
    if (!vellRaw || !nouRaw) { enviaBLE("ERR|REN|FORMAT"); return; }
    char vell[LEN_NOM], nou[LEN_NOM];
    aFolreASCII(vell, vellRaw, sizeof(vell));
    aFolreASCII(nou, nouRaw, sizeof(nou));
    int idx = trobaPerNom(vell);
    if (idx < 0) { enviaBLE("ERR|REN|NOTFOUND"); return; }
    if (trobaPerNom(nou) >= 0) { enviaBLE("ERR|REN|DUP"); return; }
    strncpy(presets[idx].nom, nou, LEN_NOM - 1);
    presets[idx].nom[LEN_NOM - 1] = '\0';
    reordenaPerNom();
    desaNVS();
    char resp[64]; snprintf(resp, sizeof(resp), "OK|REN|%s", nou);
    enviaBLE(resp);

  } else if (strcmp(cmd, "SEL") == 0) {
    // Ronda 11: el mobil activa explicitament un perfil al dispositiu —
    // dispara la pantalla "Carregat satisfactoriament" (vegeu loop()/
    // dibuixaSplash()). No es el mateix que triar VARIETAT amb AMUNT/AVALL
    // al dispositiu, que no la mostra.
    char *nomRaw = strtok_r(NULL, "|", &guarda);
    if (!nomRaw) { enviaBLE("ERR|SEL|FORMAT"); return; }
    char nom[LEN_NOM]; aFolreASCII(nom, nomRaw, sizeof(nom));
    int idx = trobaPerNom(nom);
    if (idx < 0) { enviaBLE("ERR|SEL|NOTFOUND"); return; }
    activaPerfilISplash(idx);
    char resp[64]; snprintf(resp, sizeof(resp), "OK|SEL|%s", nom);
    enviaBLE(resp);

  } else {
    enviaBLE("ERR|CMD|DESCONEGUDA");
  }
}

// ================================================================== dibuix
// Tot el text centrat dins la seva caixa (getTextBounds ja compensa la
// linia de base diferent que fan servir els Free Fonts respecte al tipus
// de lletra classic d'Adafruit_GFX).
void centraText(int x, int y, int w, int h, const char *text) {
  int16_t x1, y1; uint16_t tw, th;
  epd.canvas.getTextBounds(text, 0, 0, &x1, &y1, &tw, &th);
  int cx = x + ((int)w - (int)tw) / 2 - x1;
  int cy = y + ((int)h - (int)th) / 2 - y1;
  epd.canvas.setCursor(cx, cy);
  epd.canvas.print(text);
}

void dibuixa() {
  epd.canvas.fillScreen(CP_BLANC);
  epd.canvas.setTextColor(CP_NEGRE);
  epd.canvas.setTextWrap(false);
  epd.canvas.setTextSize(1);

  // Ronda 11: pantalla "carregat" — substitueix tota la resta (capcalera,
  // icona de la cafetera, camps...) mentre esta activa.
  if (splashActiva) { dibuixaSplash(); return; }

  // Icona a la dreta (a peticio de l'usuari) — abans era a l'esquerra amb
  // el titol a x=94. Ronda 5: el titol ara es centra entre el marge
  // esquerre (x=8) i la icona, en lloc de començar arran del marge —
  // getTextBounds ja ho calcula (centraText), no cal cap numero fixe.
  epd.canvas.drawBitmap(CP_W - ICONA_MARGE_DRETA - ICONA_W, ICONA_Y, ICONA_CAFETERA, ICONA_W, ICONA_H, CP_NEGRE);

  epd.canvas.setFont(&CoffeeFreeTitle);
  {
    // Ronda 7: als submenus de MOLTA i GRAMS, el titol principal
    // "RECEPTES DE CAFE" es substitueix pel titol del submenu mateix —
    // allibera l'espai on abans hi havia una segona linia de titol a part
    // (vegeu dibuixaPicker). Ronda 9: el mateix criteri s'aplica ara a
    // TOTS els pickers (tambe VARIETAT i NOTES), no nomes MOLTA/GRAMS.
    const char *titol = pickerObert ? titolPicker() : "RECEPTES DE CAF\xC8";
    int16_t tx1, ty1; uint16_t tw, th;
    epd.canvas.getTextBounds(titol, 0, 0, &tx1, &ty1, &tw, &th);
    int regioW = (CP_W - ICONA_MARGE_DRETA - ICONA_W) - 8;   // entre el marge esquerre i la icona
    epd.canvas.setCursor(8 + ((int)regioW - (int)tw) / 2 - tx1, 52);
    epd.canvas.print(titol);
  }

  // Indicador BLE + asterisc "brut": ara a l'esquerra (mirall de l'antiga
  // posicio a la dreta), perque la cantonada superior dreta l'ocupa la icona.
  epd.canvas.setFont(&CoffeeFreeSmall);
  if (bleConnectat) epd.canvas.fillCircle(16, 12, 4, CP_NEGRE);
  else              epd.canvas.drawCircle(16, 12, 4, CP_NEGRE);
  if (brut) { epd.canvas.setCursor(26, 18); epd.canvas.print("*"); }

  if (pickerObert) { dibuixaPicker(); return; }

  if (numPresets == 0) {
    epd.canvas.setFont(&CoffeeFreeTitle);
    centraText(0, 125, CP_W, 30, "Cap caf\xE8 desat");
    epd.canvas.setFont(&CoffeeFreeSmall);
    centraText(0, 170, CP_W, 22, "Afegeix-ne un des del m\xF2" "bil (BLE)");
    dibuixaPeu();
    return;
  }

  // "VARIETAT" — ronda 5: ja no hi ha linia de separacio sota la capcalera;
  // l'etiqueta puja a ocupar aproximadament aquell mateix espai.
  epd.canvas.setFont(&CoffeeFreeSmall);
  centraText(8, VARIETAT_Y, 384, VARIETAT_H, "VARIETAT");

  // Caixa NOM — ronda 5: sense vora permanent (nomes el focus la dibuixa,
  // vegeu dibuixaFocus, quan aquest es el camp actiu). Ronda 7: paper propi
  // CoffeeFreeNom (40px, abans compartia CoffeeFreeValue amb GRAMS/MOLTA a
  // 32px) — es va separar perque ara es fan servir noms curts i hi ha marge
  // per pujar nomes aquest, sense tocar els valors de GRAMS/MOLTA.
  epd.canvas.setFont(&CoffeeFreeNom);
  centraText(8, NOM_Y, 384, NOM_H, presets[selIndex].nom);
  if (campActiu == CAMP_NOM && mostraFocus) dibuixaFocus(5, NOM_Y - 3, 390, NOM_H + 6, editant);

  // Caselles GRAMS / MOLTA / NOTES — ronda 5: ja no hi ha cap requadre
  // exterior ni vora al valor; nomes queda la capcalera negra (ara amb les
  // 4 cantonades arrodonides) i el valor flotant a sota. El focus (quan
  // s'hi navega o modifica) es l'unica vora que hi apareix.
  const int boxW = (384 - 2 * GRAMS_MARGE_LAT - 2 * 9) / 3;   // 9px entre caselles
  const int x1 = 8 + GRAMS_MARGE_LAT;
  const int x2 = x1 + boxW + 9;
  const int x3 = x2 + boxW + 9;
  dibuixaCaixaValor(x1, GRAMS_Y, boxW, GRAMS_HCAP, GRAMS_HVAL, "GRAMS", formataNum(presets[selIndex].grams, "gr"), campActiu == CAMP_GRAMS && mostraFocus, editant);
  dibuixaCaixaValor(x2, GRAMS_Y, boxW, GRAMS_HCAP, GRAMS_HVAL, "MOLTA", formataNum(presets[selIndex].molta, ""),  campActiu == CAMP_MOLTA && mostraFocus, editant);
  dibuixaCaixaValor(x3, GRAMS_Y, boxW, GRAMS_HCAP, GRAMS_HVAL, "NOTES", presets[selIndex].notes,                  campActiu == CAMP_NOTES && mostraFocus, editant);

  // Ronda 7: la llegenda de botons tambe desapareix amb EXIT (mateix
  // mostraFocus que el requadre de focus) — pantalla del tot neta.
  if (mostraFocus) dibuixaPeu();
}

// ---------------------------------------------------- pantalla "carregat"
// Ronda 11: nom de la varietat + "Carregat satisfactoriament" + icona dels
// grans de cafe. Nomes es mostra quan el mobil selecciona un perfil via BLE
// (SEL), no en navegar-hi localment.
// Ronda 11c: vas demanar canviar l'ordre — icona A DALT, text A BAIX (abans
// era text a dalt, icona a sota) — i vas passar el bitmap real via image2cpp
// (400x300px). Escalat a 213x160 (vegeu ICONA_GRANS_CAFE mes amunt) perque
// entri dins la caixa de ~300x160 que havies demanat sense deformar-lo.
// Geometria: icona centrada a Y=14 (fins a 174), NOM a 184 (fins a 230),
// missatge a 234 (fins a 264) — 36px de marge net fins al peu de pantalla.
#define SPLASH_ICONA_Y  14
#define SPLASH_NOM_Y    184
#define SPLASH_NOM_H    46
#define SPLASH_MSG_Y    234
#define SPLASH_MSG_H    30

void dibuixaSplash() {
  int iconaX = (CP_W - ICONA_GRANS_W) / 2;
  epd.canvas.drawBitmap(iconaX, SPLASH_ICONA_Y, ICONA_GRANS_CAFE, ICONA_GRANS_W, ICONA_GRANS_H, CP_NEGRE);

  epd.canvas.setFont(&CoffeeFreeNom);
  centraText(8, SPLASH_NOM_Y, CP_W - 16, SPLASH_NOM_H, splashNom);

  epd.canvas.setFont(&CoffeeFreeTitle);
  centraText(8, SPLASH_MSG_Y, CP_W - 16, SPLASH_MSG_H, "Carregat satisfact\xF2riament");
}

// Vora de focus: senzilla quan nomes estas "navegant" (aqui hi ha el focus
// pero encara no el modifiques), doble quan estas "modificant" (mateix
// aspecte d'abans) — aixi es distingeix d'un cop d'ull quin mode toca.
void dibuixaFocus(int x, int y, int w, int h, bool editantAra) {
  epd.canvas.drawRoundRect(x, y, w, h, 10, CP_NEGRE);
  if (editantAra) epd.canvas.drawRoundRect(x + 1, y + 1, w - 2, h - 2, 9, CP_NEGRE);
}

// Capcalera en negre amb text blanc ("GRAMS"/"MOLTA"/"NOTES") i, a sota, el
// valor flotant sense cap vora (ronda 5 — abans hi havia una caixa blanca
// amb vora permanent). El focus (quan aquest es el camp actiu) nomes
// envolta la zona del valor, no la capcalera negra — evitar invertir una
// caixa gran sencera (NOTES-CrowPanel42.md #5).
void dibuixaCaixaValor(int x, int yCapcalera, int w, int hCapcalera, int hValor,
                        const char *etiqueta, const char *valor, bool actiu, bool editantAra) {
  epd.canvas.setFont(&CoffeeFreeSmall);   // capcalera sempre a la mida "label", sigui quin sigui el camp anterior
  epd.canvas.fillRoundRect(x, yCapcalera, w, hCapcalera, GRAMS_R, CP_NEGRE);   // 4 cantonades, ja no nomes les de dalt
  epd.canvas.setTextColor(CP_BLANC);
  centraText(x, yCapcalera, w, hCapcalera, etiqueta);
  epd.canvas.setTextColor(CP_NEGRE);

  int yValor = yCapcalera + hCapcalera + GRAMS_GAP;
  bool esNotes = (strcmp(etiqueta, "NOTES") == 0);
  if (esNotes) {
    dibuixaValorNotes(x, yValor, w, hValor, valor);
  } else {
    epd.canvas.setFont(&CoffeeFreeValue);
    centraNumero(x, yValor, w, hValor, valor);
    epd.canvas.setFont(&CoffeeFreeSmall);
  }
  if (actiu) dibuixaFocus(x - 3, yValor - 3, w + 6, hValor + 6, editantAra);
}

// GRAMS i MOLTA es dibuixaven centrats segons el propi bounding box de cada
// cadena — pero "18gr" porta una "g" amb descendent i "72" no, aixi que
// els dos valors no quedaven a la mateixa alcada visual. Centrem sempre amb
// l'alcada de referencia d'un digit sol ("0", sense descendents), nomes
// l'amplada ve de la cadena real — aixi els dos numeros comparteixen la
// mateixa linia de base encara que un tingui unitat i l'altre no.
void centraNumero(int x, int y, int w, int h, const char *text) {
  int16_t x1, y1, xr, yr; uint16_t tw, th, twr, thr;
  epd.canvas.getTextBounds(text, 0, 0, &x1, &y1, &tw, &th);
  epd.canvas.getTextBounds("0",  0, 0, &xr, &yr, &twr, &thr);
  int cx = x + ((int)w - (int)tw)  / 2 - x1;
  int cy = y + ((int)h - (int)thr) / 2 - yr;
  epd.canvas.setCursor(cx, cy);
  epd.canvas.print(text);
}

// Les notes poden ser fins a 3 paraules separades per ", ": sempre una per
// linia (encara que en fossin dues i hi cabessin totes dues juntes, es
// tallarien per la vora amb noms una mica llargs, aixi que no ho arrisquem).
void dibuixaValorNotes(int x, int y, int w, int h, const char *text) {
  epd.canvas.setFont(&CoffeeFreeSmall);

  char copia[LEN_NOTES];
  strncpy(copia, text, sizeof(copia) - 1);
  copia[sizeof(copia) - 1] = '\0';

  char *tokens[3];
  int n = 0;
  char *tok = strtok(copia, ",");
  while (tok && n < 3) {
    while (*tok == ' ') tok++;
    tokens[n++] = tok;
    tok = strtok(NULL, ",");
  }

  if (n <= 1) {
    centraText(x, y, w, h, text);
    return;
  }

  int hLinia = h / n;
  for (int i = 0; i < n; i++) {
    centraText(x, y + i * hLinia, w, hLinia, tokens[i]);
  }
}

// Llegenda de botons: CoffeeFreeSmall, la mida mes petita de totes — es
// informacio secundaria, no cal que competeixi visualment amb la resta de
// la pantalla. Ronda 5: sense linia de separacio a sobre (com tota la
// resta de la interficie); l'espai en blanc que queda per sobre ja marca
// prou la separacio respecte la graella GRAMS/MOLTA/NOTES.
void dibuixaPeu() {
  epd.canvas.setFont(&CoffeeFreeSmall);
  epd.canvas.setCursor(8, FOOTER_Y1);
  epd.canvas.print("AMUNT/AVALL:mou   OK:modifica");
  epd.canvas.setCursor(8, FOOTER_Y2);
  epd.canvas.print("MENU:llista   EXIT:desa canvis");
}

void dibuixaPicker() {
  // Ronda 7: MOLTA i GRAMS ja mostren el seu titol dalt de tot (a on hi
  // havia "RECEPTES DE CAFE", vegeu dibuixa()). Ronda 9: NOM i NOTES fan el
  // mateix — no repetim una segona linia de titol aqui per cap dels 4
  // pickers, l'espai que abans ocupava (y=74) es reparteix pujant les files.
  if (campActiu == CAMP_MOLTA) { dibuixaPickerMolta(); return; }
  if (campActiu == CAMP_GRAMS) { dibuixaPickerGrams(); return; }

  // Files mes altes (ronda 3: 26->38px) perque hi capiguen les xifres a
  // CoffeeFreeTitle; per aixo nomes se'n veuen 4 en lloc de 5 — amb la lletra
  // mes gran no hi cap una cinquena sense allargar el scroll.
  const int filaH = 38;
  const int visibles = 4;
  if (pickerSel < pickerScroll) pickerScroll = pickerSel;
  if (pickerSel >= pickerScroll + visibles) pickerScroll = pickerSel - visibles + 1;

  epd.canvas.setFont(&CoffeeFreeTitle);
  for (int fila = 0; fila < visibles; fila++) {
    int i = pickerScroll + fila;
    if (i >= pickerN) break;
    // Ronda 9: pujades de 102 a 82 (mateix punt de partida que les
    // capcaleres de columna de MOLTA/GRAMS) ara que no hi ha una segona
    // linia de titol a sobre. Ronda 10: baixades de 82 a 98 perque la
    // primera fila (VARIETAT/NOTES) no es solapi amb la icona de la
    // cafetera (y=10..88, vegeu MOLTA_COL_Y mes avall per la mateixa
    // correccio a MOLTA/GRAMS).
    int y = 98 + fila * filaH;

    char linia[LEN_NOTES + 6];
    if (pickerEsCapcalera[i]) {
      snprintf(linia, sizeof(linia), "%s", pickerEtiquetes[i]);
    } else if (campActiu == CAMP_NOTES) {
      snprintf(linia, sizeof(linia), "%s %s", pickerMarcat[i] ? "[X]" : "[ ]", pickerEtiquetes[i]);
    } else {
      snprintf(linia, sizeof(linia), "%s", pickerEtiquetes[i]);
    }
    epd.canvas.setCursor(16, y + 28);
    epd.canvas.print(linia);
    if (i == pickerSel && !pickerEsCapcalera[i]) epd.canvas.drawRoundRect(6, y, 388, filaH - 4, 4, CP_NEGRE);
  }

  // Ronda 5: sense linia de separacio abans de la llegenda; fem servir les
  // mateixes FOOTER_Y1/FOOTER_Y2 que la pantalla principal, per coherencia
  // visual entre totes les pantalles.
  epd.canvas.setFont(&CoffeeFreeSmall);
  if (campActiu == CAMP_NOTES) {
    epd.canvas.setCursor(8, FOOTER_Y1);
    epd.canvas.print("OK:marca/desmarca (max 3)");
    epd.canvas.setCursor(8, FOOTER_Y2);
    epd.canvas.print("MENU:aplica seleccio  EXIT:cancela");
  } else {
    epd.canvas.setCursor(8, FOOTER_Y1);
    epd.canvas.print("OK:tria aquest valor");
    epd.canvas.setCursor(8, FOOTER_Y2);
    epd.canvas.print("EXIT:tanca sense triar");
  }
}

// Picker de MOLTA (ronda 5): dues columnes fixes en lloc d'una llista amb
// dues seccions ("-- ESPRESSO --" / "-- V60 --") que calia baixar per
// veure — ara Espresso i V60 es veuen sempre alhora, cadascuna amb el seu
// propi scroll independent. La columna activa (on mouen AMUNT/AVALL) es
// marca en negre, igual que les capcaleres GRAMS/MOLTA/NOTES de la
// pantalla principal; MENU salta a l'altra columna.
#define MOLTA_COL_GUTTER 10
#define MOLTA_COL_W      ((384 - MOLTA_COL_GUTTER) / 2)
// Ronda 7: capcaleres de columna pujades i mes altes (ara en CoffeeFreeTitle
// 25px en lloc de CoffeeFreeSmall 16px, vegeu dibuixaPickerMolta/Grams) —
// possible perque ja no hi ha una segona linia de titol a y=74 (el titol
// del submenu ara surt a on abans hi havia "RECEPTES DE CAFE", vegeu
// dibuixa()/dibuixaPicker()), aixi que queda espai lliure per pujar tot.
// Ronda 10: MOLTA_COL_Y baixat de 82 a 98 — la icona de la cafetera (sempre
// dibuixada, tambe als submenus) ocupa y=10..88 a la dreta de la pantalla, i
// la columna dreta (V60/Dosis doble, colX[1]) hi cau just a sota — quan
// s'activa (requadre negre) es solapava amb la icona. Amb 98 hi ha 10px lliures
// respecte la icona. MOLTA_ROWS_Y puja proporcionalment (mateix marge de 6px
// que abans entre capcalera i files) i encara queda prou marge fins al peu.
#define MOLTA_COL_Y      98
#define MOLTA_COL_H      32
#define MOLTA_ROWS_Y     136
#define MOLTA_FILA_H     34
#define MOLTA_VISIBLES   4

void dibuixaPickerMolta() {
  int colX[2] = { 8, 8 + MOLTA_COL_W + MOLTA_COL_GUTTER };
  const char *etiquetes[2] = { "Espresso", "V60" };

  // Ronda 7: capcalera de columna en CoffeeFreeTitle (25px) en lloc de
  // CoffeeFreeSmall (16px) — es llegeix molt millor de lluny.
  epd.canvas.setFont(&CoffeeFreeTitle);
  for (int c = 0; c < 2; c++) {
    if (c == moltaColActiva) {
      epd.canvas.fillRoundRect(colX[c], MOLTA_COL_Y, MOLTA_COL_W, MOLTA_COL_H, 8, CP_NEGRE);
      epd.canvas.setTextColor(CP_BLANC);
      centraText(colX[c], MOLTA_COL_Y, MOLTA_COL_W, MOLTA_COL_H, etiquetes[c]);
      epd.canvas.setTextColor(CP_NEGRE);
    } else {
      centraText(colX[c], MOLTA_COL_Y, MOLTA_COL_W, MOLTA_COL_H, etiquetes[c]);
    }
  }

  // Finestra de scroll retallada perque el seleccionat de cada columna
  // sempre hi sigui visible (mateixa idea que a dibuixaPicker, per duplicat
  // perque aqui son dues finestres independents).
  if (moltaSelEsp < moltaScrollEsp) moltaScrollEsp = moltaSelEsp;
  if (moltaSelEsp >= moltaScrollEsp + MOLTA_VISIBLES) moltaScrollEsp = moltaSelEsp - MOLTA_VISIBLES + 1;
  if (moltaSelV60 < moltaScrollV60) moltaScrollV60 = moltaSelV60;
  if (moltaSelV60 >= moltaScrollV60 + MOLTA_VISIBLES) moltaScrollV60 = moltaSelV60 - MOLTA_VISIBLES + 1;

  epd.canvas.setFont(&CoffeeFreeTitle);
  for (int fila = 0; fila < MOLTA_VISIBLES; fila++) {
    int y = MOLTA_ROWS_Y + fila * MOLTA_FILA_H;

    int iEsp = moltaScrollEsp + fila;
    if (iEsp < MOLTA_ESP_N) {
      char buf[4]; snprintf(buf, sizeof(buf), "%d", MOLTA_ESP_MIN + iEsp);
      centraText(colX[0], y, MOLTA_COL_W, MOLTA_FILA_H - 4, buf);
      if (moltaColActiva == 0 && iEsp == moltaSelEsp)
        epd.canvas.drawRoundRect(colX[0] - 3, y - 2, MOLTA_COL_W + 6, MOLTA_FILA_H - 4, 6, CP_NEGRE);
    }
    int iV60 = moltaScrollV60 + fila;
    if (iV60 < MOLTA_V60_N) {
      char buf[4]; snprintf(buf, sizeof(buf), "%d", MOLTA_V60_MIN + iV60);
      centraText(colX[1], y, MOLTA_COL_W, MOLTA_FILA_H - 4, buf);
      if (moltaColActiva == 1 && iV60 == moltaSelV60)
        epd.canvas.drawRoundRect(colX[1] - 3, y - 2, MOLTA_COL_W + 6, MOLTA_FILA_H - 4, 6, CP_NEGRE);
    }
  }

  epd.canvas.setFont(&CoffeeFreeSmall);
  epd.canvas.setCursor(8, FOOTER_Y1);
  epd.canvas.print("AMUNT/AVALL:mou   MENU:columna");
  epd.canvas.setCursor(8, FOOTER_Y2);
  epd.canvas.print("OK:tria aquest valor   EXIT:cancela");
}

// Picker de GRAMS (ronda 6): mateix disseny de dues columnes que MOLTA —
// "Dosis simple" (17-18gr) i "Dosis doble" (19-22gr) — reutilitzant la
// mateixa geometria (MOLTA_COL_*) perque son pantalles bessones.
void dibuixaPickerGrams() {
  int colX[2] = { 8, 8 + MOLTA_COL_W + MOLTA_COL_GUTTER };
  const char *etiquetes[2] = { "Dosis simple", "Dosis doble" };

  // Ronda 7: capcalera de columna en CoffeeFreeTitle (25px) en lloc de
  // CoffeeFreeSmall (16px) — es llegeix molt millor de lluny.
  epd.canvas.setFont(&CoffeeFreeTitle);
  for (int c = 0; c < 2; c++) {
    if (c == gramsColActiva) {
      epd.canvas.fillRoundRect(colX[c], MOLTA_COL_Y, MOLTA_COL_W, MOLTA_COL_H, 8, CP_NEGRE);
      epd.canvas.setTextColor(CP_BLANC);
      centraText(colX[c], MOLTA_COL_Y, MOLTA_COL_W, MOLTA_COL_H, etiquetes[c]);
      epd.canvas.setTextColor(CP_NEGRE);
    } else {
      centraText(colX[c], MOLTA_COL_Y, MOLTA_COL_W, MOLTA_COL_H, etiquetes[c]);
    }
  }

  if (gramsSelSimple < gramsScrollSimple) gramsScrollSimple = gramsSelSimple;
  if (gramsSelSimple >= gramsScrollSimple + MOLTA_VISIBLES) gramsScrollSimple = gramsSelSimple - MOLTA_VISIBLES + 1;
  if (gramsSelDoble < gramsScrollDoble) gramsScrollDoble = gramsSelDoble;
  if (gramsSelDoble >= gramsScrollDoble + MOLTA_VISIBLES) gramsScrollDoble = gramsSelDoble - MOLTA_VISIBLES + 1;

  epd.canvas.setFont(&CoffeeFreeTitle);
  for (int fila = 0; fila < MOLTA_VISIBLES; fila++) {
    int y = MOLTA_ROWS_Y + fila * MOLTA_FILA_H;

    int iSimple = gramsScrollSimple + fila;
    if (iSimple < GRAMS_SIMPLE_N) {
      char buf[8]; snprintf(buf, sizeof(buf), "%dgr", GRAMS_SIMPLE_MIN + iSimple);
      centraText(colX[0], y, MOLTA_COL_W, MOLTA_FILA_H - 4, buf);
      if (gramsColActiva == 0 && iSimple == gramsSelSimple)
        epd.canvas.drawRoundRect(colX[0] - 3, y - 2, MOLTA_COL_W + 6, MOLTA_FILA_H - 4, 6, CP_NEGRE);
    }
    int iDoble = gramsScrollDoble + fila;
    if (iDoble < GRAMS_DOBLE_N) {
      char buf[8]; snprintf(buf, sizeof(buf), "%dgr", GRAMS_DOBLE_MIN + iDoble);
      centraText(colX[1], y, MOLTA_COL_W, MOLTA_FILA_H - 4, buf);
      if (gramsColActiva == 1 && iDoble == gramsSelDoble)
        epd.canvas.drawRoundRect(colX[1] - 3, y - 2, MOLTA_COL_W + 6, MOLTA_FILA_H - 4, 6, CP_NEGRE);
    }
  }

  epd.canvas.setFont(&CoffeeFreeSmall);
  epd.canvas.setCursor(8, FOOTER_Y1);
  epd.canvas.print("AMUNT/AVALL:mou   MENU:columna");
  epd.canvas.setCursor(8, FOOTER_Y2);
  epd.canvas.print("OK:tria aquest valor   EXIT:cancela");
}
